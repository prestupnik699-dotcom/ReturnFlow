{
  "expo": {
    "name": "ReturnFlow",
    "slug": "returnflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "returnflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.returnflow.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0A1A"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.returnflow.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ReturnFlow использует Face ID для быстрого и безопасного входа в приложение"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ReturnFlow использует камеру для сканирования штрихкодов товаров"
        }
      ],
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F141B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6C5CE7"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "flutterflow-x5",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ReturnFlow использует микрофон для голосового ввода названий товаров",
          "speechRecognitionPermission": "ReturnFlow использует распознавание речи для голосового ввода названий товаров"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c1938bc-1efc-4a3d-8f36-7e051f114642"
      }
    },
    "owner": "hovoo"
  }
}
